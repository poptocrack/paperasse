{
  "name": "paperasse",
  "version": "0.0.0",
  "private": true,
  "description": "paperasse — CLI open-source qui rapproche automatiquement les factures reçues sur Gmail avec les transactions Qonto.",
  "license": "MIT",
  "author": "Tristan Debroise",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter paperasse dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
