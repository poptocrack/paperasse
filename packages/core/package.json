{
  "name": "@paperasse/core",
  "version": "0.0.0",
  "private": true,
  "description": "Core library: types, SQLite schema, matcher, sender extractors.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./matcher": {
      "types": "./dist/matcher/index.d.ts",
      "import": "./dist/matcher/index.js"
    },
    "./gmail": {
      "types": "./dist/gmail/index.d.ts",
      "import": "./dist/gmail/index.js"
    },
    "./qonto": {
      "types": "./dist/qonto/index.d.ts",
      "import": "./dist/qonto/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark/index.d.ts",
      "import": "./dist/benchmark/index.js"
    },
    "./vendors": {
      "types": "./dist/vendors/index.d.ts",
      "import": "./dist/vendors/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "better-sqlite3": "^12.9.0",
    "googleapis": "^171.4.0",
    "open": "^11.0.0"
  }
}
